# ── Database (already configured in .env for this sandbox) ──────────────────
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Quote-form e-mail delivery (SMTP) ────────────────────────────────────────
# Inquiries are ALWAYS saved to the database. Fill these in to also e-mail them
# to the NBA business inbox (works with Gmail/Google Workspace app passwords,
# Zoho, Outlook, Brevo, Mailgun, SendGrid SMTP, etc.).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=uneeb@nbaglass.com
SMTP_PASS=your_vk_external_app_password
SMTP_FROM="NBA Website <no-reply@your-domain.com>"
QUOTE_TO_EMAIL=uneeb@nbaglass.com


# ── Admin inbox (view saved inquiries at /admin/inquiries?token=...) ─────────
ADMIN_TOKEN=choose-a-long-random-string

# ── Public business details (see src/data/site.ts) ───────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_WHATSAPP_DISPLAY="+92 300 1234567"
NEXT_PUBLIC_BUSINESS_PHONE="+92 21 1234567"
NEXT_PUBLIC_BUSINESS_EMAIL=sales@your-domain.com
NEXT_PUBLIC_BUSINESS_ADDRESS="Full factory address, City, Pakistan"
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_BUSINESS_VERIFIED=false
